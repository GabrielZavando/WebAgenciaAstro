---
interface Props {
  id: string; // HTML ID para el tbody
}

const { id } = Astro.props;
---

<div class="ticket-table-container">
  <table class="unified-ticket-table">
    <thead>
      <tr>
        <th class="col-client">Cliente</th>
        <th class="col-subject">Idea</th>
        <th class="col-date">Fecha Enviado</th>
        <th class="col-actions">Detalles</th>
      </tr>
    </thead>
    <tbody id={id}>
      <tr>
        <td colspan="4">
          <div class="loading-state">
            <span class="material-symbols-outlined spin">sync</span>
            <p>Cargando ideas...</p>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<style>
  /* Hereda estilos globales de unified-ticket-table pero podemos añadir específicos si es necesario */
  .col-actions {
    width: 150px;
    text-align: center;
  }
</style>
