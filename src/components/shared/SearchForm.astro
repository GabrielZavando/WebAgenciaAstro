---
interface Props {
  id: string;
  placeholder?: string;
  label?: string;
}

const { id, placeholder = "Buscar...", label = "Buscar" } = Astro.props;
---

<div class="header-search-row">
  <form class="search-form" onsubmit="return false;">
    <label for={id} class="sr-only">{label}</label>
    <input 
      type="text" 
      id={id} 
      class="search-input" 
      placeholder={placeholder} 
      autocomplete="off" 
    />
    <button type="submit" class="search-btn">Buscar</button>
  </form>
</div>

<style>
  .header-search-row {
    width: 100%;
    display: flex;
    justify-content: flex-start; /* Alineado a la izquierda por defecto en admin */
    margin-bottom: 1.5rem;
  }
</style>
