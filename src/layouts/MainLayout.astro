---
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import Head from "../components/shared/Head.astro";
import Schema from "../components/shared/Schema.astro";
import { getSystemConfig } from "../utils/config";

const config = await getSystemConfig();

interface Props {
  title?: string;
  description?: string;
  alwaysScrolledNav?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  forcedTheme?: 'light' | 'dark';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}
const {
  title = config.name,
  description = config.description,
  alwaysScrolledNav = false,
  hideHeader = false,
  hideFooter = false,
  forcedTheme,
  ogTitle,
  ogDescription,
  ogImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme={forcedTheme} data-forced-theme={forcedTheme}>
  <head>
    <Head 
      title={title} 
      description={description} 
      faviconUrl={config.faviconUrl} 
      forcedTheme={forcedTheme}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
    />
    <Schema config={config} />
    {/* Cloudflare Turnstile - Centralizado */}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body>
    {import.meta.env.PUBLIC_GTM_ID && (
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_ID}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    )}
    {!hideHeader && <Header alwaysScrolled={alwaysScrolledNav} config={config} />}
    <slot />
    {!hideFooter && <Footer config={config} />}
    {!hideFooter && (
      <button id="scroll-top" class="btn-up" aria-label="Volver arriba">
        <span class="material-symbols-outlined">north</span>
      </button>
    )}

    <!-- Scripts -->
    <script>
      function initLayout() {
        // Scroll top button
        const scrollBtn = document.getElementById('scroll-top');
        if (scrollBtn) {
          window.removeEventListener('scroll', (window as any)._scrollHandler);
          (window as any)._scrollHandler = () => {
            if (window.scrollY > 200) scrollBtn.classList.add('visible');
            else scrollBtn.classList.remove('visible');
          };
          window.addEventListener('scroll', (window as any)._scrollHandler);
          
          scrollBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            scrollBtn.classList.remove('visible');
          });
        }

        // --- Sistema unificado de animaciones fade-in ---
        const observerOptions = { 
          threshold: 0.1, // Reducido para mayor sensibilidad
          rootMargin: '0px 0px -50px 0px' 
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate');
              // Una vez animado, dejar de observar para ahorrar recursos
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const fadeElements = document.querySelectorAll('.fade-in');
        
        // Función para forzar animaciones en un contenedor (ej: al saltar a un ID)
        const forceAnimateInSection = (sectionId: string) => {
          const targetSection = document.querySelector(sectionId);
          if (targetSection) {
            const elementsToAnimate = targetSection.querySelectorAll('.fade-in');
            elementsToAnimate.forEach(el => el.classList.add('animate'));
          }
        };

        fadeElements.forEach((el) => {
          observer.observe(el);
          
          // Si está visible al cargar, animar inmediatamente
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            setTimeout(() => {
              el.classList.add('animate');
            }, 100);
          }
        });

        // --- Fix para navegación por anclas (Menú Planes, etc) ---
        // 1. Manejar clics en enlaces con ancla
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const link = target.closest('a');
          if (link && link.hash && (link.pathname === window.location.pathname || link.pathname === '/')) {
            // Dar un pequeño margen para que el scroll ocurra y forzar animación
            setTimeout(() => forceAnimateInSection(link.hash), 100);
            setTimeout(() => forceAnimateInSection(link.hash), 500); // Doble check por si el scroll es lento
          }
        });

        // 2. Manejar carga inicial con hash
        if (window.location.hash) {
          setTimeout(() => forceAnimateInSection(window.location.hash), 500);
        }
      }

      document.addEventListener('DOMContentLoaded', initLayout);
      document.addEventListener('astro:page-load', initLayout);
    </script>
  </body>
</html>
