---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { apiFetch } from '../../../lib/api-client';

const { id } = Astro.params;
const token = Astro.cookies.get('session')?.value;

if (!token) {
  return Astro.redirect('/login');
}

let idea: any = null;
let error = false;

try {
  idea = await apiFetch(`/ideas/${id}`, { token });
} catch (err) {
  console.error('[SSR Idea Detail] Error:', err);
  error = true;
}

const dateStr = idea?.createdAt ? new Date(idea.createdAt).toLocaleDateString('es-CL', {
  day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'
}) : '-';
---

<DashboardLayout 
  title="Detalle de Idea" 
  breadcrumbs={[
    { label: 'Admin', href: '/admin' }, 
    { label: 'Ideas', href: '/admin/ideas' },
    { label: 'Detalle' }
  ]} 
  role="admin"
>
  <div class="ideas-admin-detail">
    {error || !idea ? (
      <div class="error-state-container card">
        <span class="material-symbols-outlined text-error">error</span>
        <h3>Error al cargar la idea</h3>
        <p>No se pudo recuperar la información de la idea solicitada.</p>
        <a href="/admin/ideas" class="btn btn-cta mt-4">Volver al listado</a>
      </div>
    ) : (
      <div class="idea-detail-container fade-in">
        <header class="detail-top-header">
          <div class="header-info">
            <span class="badge-primary">Idea de Cliente</span>
            <h1>{idea.name || 'Sin nombre'}</h1>
            <div class="header-meta">
              <div class="meta-item">
                <span class="material-symbols-outlined">event</span>
                <span>{dateStr}</span>
              </div>
              <div class="meta-item">
                <span class="material-symbols-outlined">person</span>
                <span>Por: <strong class="text-primary">{idea.clientName || 'Usuario'}</strong></span>
              </div>
            </div>
          </div>
          <div class="header-actions">
             <button class="btn btn-danger-outline" id="btnDeleteIdea" data-id={id}>
               <span class="material-symbols-outlined">delete</span> Eliminar
             </button>
          </div>
        </header>

        <div class="detail-main-layout">
          <div class="detail-content-area">
            <section class="detail-section">
              <h2 class="section-title">
                <span class="material-symbols-outlined">description</span>
                Descripción de la propuesta
              </h2>
              <div class="content-box">
                <p>{idea.explanation || 'Sin descripción detallada.'}</p>
              </div>
            </section>

            {idea.imageUrl && (
              <section class="detail-section">
                <h2 class="section-title">
                  <span class="material-symbols-outlined">image</span>
                  Material visual adjunto
                </h2>
                <div class="image-showcase">
                  <img src={idea.imageUrl} alt={idea.name} class="detail-image" />
                  <a href={idea.imageUrl} target="_blank" class="btn-zoom-overlay">
                    <span class="material-symbols-outlined">open_in_new</span> Ver en pantalla completa
                  </a>
                </div>
              </section>
            )}
          </div>
        </div>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  import { apiClient } from "../../../lib/api-client";

  function setupActions() {
    const btnDelete = document.getElementById('btnDeleteIdea');
    if (!btnDelete) return;

    btnDelete.addEventListener('click', async () => {
      const id = btnDelete.dataset.id;
      if (confirm('¿Estás seguro de que deseas eliminar esta idea permanentemente?')) {
        try {
          await apiClient.delete(`/ideas/${id}`);
          window.location.href = '/admin/ideas';
        } catch (err) {
          alert('Error al intentar eliminar la idea.');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', setupActions);
</script>

<style>
  .ideas-admin-detail {
    padding-bottom: 4rem;
  }

  /* Container */
  .idea-detail-container {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0; /* Flat style */
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  /* Header */
  .detail-top-header {
    padding: 3rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-secondary);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .header-info h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 1rem 0;
    line-height: 1.1;
  }

  .badge-primary {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(255, 0, 128, 0.1);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .header-meta {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .text-primary { color: var(--color-primary); }

  /* Layout */
  .detail-main-layout {
    display: block;
  }

  /* Content Area */
  .detail-content-area {
    padding: 3rem;
  }

  .detail-section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title span {
    color: var(--color-primary);
  }

  .content-box {
    background: var(--color-surface-secondary);
    padding: 2.5rem;
    border-left: 4px solid var(--color-primary);
    color: var(--color-text-secondary);
    line-height: 1.8;
    font-size: 1.15rem;
    white-space: pre-wrap;
  }

  /* Image showcase */
  .image-showcase {
    position: relative;
    background: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .detail-image {
    width: 100%;
    display: block;
    max-height: 800px;
    object-fit: contain;
  }

  .btn-zoom-overlay {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    background: var(--color-primary);
    color: white;
    padding: 0.75rem 1.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
  }

  .btn-zoom-overlay:hover {
    background: var(--color-secondary);
    transform: translateY(-3px);
  }

  /* Buttons */
  .w-full { width: 100%; }
  .mt-4 { margin-top: 1.5rem; }

  .btn-danger-outline {
    background: transparent;
    color: var(--color-error);
    border: 2px solid var(--color-error);
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-danger-outline:hover {
    background: var(--color-error);
    color: white;
  }

  /* Error State */
  .error-state-container {
    padding: 5rem 2rem;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .error-state-container .material-symbols-outlined {
    font-size: 4rem;
  }
</style>
