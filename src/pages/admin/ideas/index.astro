---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import IdeaManagementSystem from '../../../components/admin/IdeaManagementSystem.astro';

const token = Astro.cookies.get('session')?.value;
if (!token) {
  return Astro.redirect('/login');
}
---

<DashboardLayout title="Banco de Ideas" breadcrumbs={[{ label: 'Admin', href: '/admin' }, { label: 'Ideas' }]} role="admin">
  <div class="support-page">
    <div class="page-header">
      <div>
        <h1>Banco de Ideas</h1>
        <p class="text-muted">Propuestas enviadas por los clientes para sus proyectos digitales.</p>
      </div>
    </div>

    <IdeaManagementSystem />
  </div>
</DashboardLayout>

<style is:global>
  /* Asegurar consistencia con la página de tickets */
  .support-page {
    padding-bottom: 2rem;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  
  .page-header h1 {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }
  
  .text-muted {
    color: #64748b;
  }
</style>
