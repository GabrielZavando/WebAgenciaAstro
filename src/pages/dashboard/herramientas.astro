---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const token = Astro.cookies.get('session')?.value;
if (!token) {
  return Astro.redirect('/login');
}

// Futuras herramientas de Gabriel Zavando
const tools = [
  {
    title: "Firmas de Correo Corporativas",
    description: "Diseña firmas profesionales y consistentes para los correos electrónicos de todo tu equipo. Próximamente disponible.",
    icon: "draw",
    status: "coming-soon",
    category: "Productividad"
  }
];
---

<DashboardLayout title="Herramientas" breadcrumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Herramientas' }]} role="client">
  <div class="tools-page">
    <div class="page-header">
      <div>
        <h1>Herramientas Exclusivas</h1>
        <p class="text-muted">Recursos desarrollados por Gabriel Zavando para potenciar la identidad y productividad de tu empresa.</p>
      </div>
    </div>

    <div class="tools-grid">
      {tools.map(tool => (
        <div class="tool-card coming-soon">
          <div class="tool-card-header">
            <div class="tool-icon-wrapper">
              <span class="material-symbols-outlined">{tool.icon}</span>
            </div>
            <span class="tool-status-badge">Próximamente</span>
          </div>
          <div class="tool-card-body">
            <div class="category-tag">{tool.category}</div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </div>
          <div class="tool-card-footer">
            <button disabled class="btn-tool-disabled">
              En desarrollo <span class="material-symbols-outlined">construction</span>
            </button>
          </div>
        </div>
      ))}

      <!-- Placeholder para futuras mentes creativas -->
      <div class="tool-card placeholder-card">
        <div class="placeholder-content">
          <span class="material-symbols-outlined">add_circle</span>
          <p>Nuevas herramientas en camino...</p>
        </div>
      </div>
    </div>

    <!-- Sección de recolección de ideas (Buzón de ideas) -->
    <div class="idea-mailbox">
      <div class="mailbox-header">
        <div class="icon-bulb">
          <span class="material-symbols-outlined">lightbulb</span>
        </div>
        <div>
          <h3>Buzón de ideas</h3>
          <p>Mi objetivo es crear utilidades que realmente te sirvan. Comparte conmigo qué herramienta facilitaría tu día a día y la desarrollaré para ti.</p>
        </div>
      </div>
      <div class="mailbox-actions">
        <a href="/dashboard/ideas/nueva" class="btn-primary btn-small">
          Enviar idea <span class="material-symbols-outlined">send</span>
        </a>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .tools-page { width: 100%; }
  .page-header { margin-bottom: 3rem; }
  .page-header h1 { margin: 0 0 0.5rem; font-size: var(--text-lg); font-weight: 700; color: var(--color-text); }
  .text-muted { color: var(--color-text-muted); margin: 0; font-size: var(--text-base); }

  /* Grid de Herramientas */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .tool-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0; /* Flat Design */
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    transition: all 0.2s ease;
    box-shadow: none;
  }

  .tool-card:hover {
    border-color: var(--color-primary);
  }

  .tool-card.coming-soon {
    border-style: dashed;
    background: rgba(var(--color-primary-rgb), 0.02);
  }

  .tool-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tool-icon-wrapper {
    width: 56px;
    height: 56px;
    background: rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0; /* Flat */
  }
  .tool-icon-wrapper span {
    font-size: 2rem;
  }

  .tool-status-badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    background: var(--color-primary);
    color: white;
    padding: 0.35rem 0.8rem;
    border-radius: 0; /* Flat */
    letter-spacing: 0.05em;
  }

  .category-tag {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .tool-card-body h3 {
    margin: 0 0 1rem;
    font-size: var(--text-md);
    color: var(--color-text);
    font-weight: 700;
  }

  .tool-card-body p {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .tool-card-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-tool-disabled {
    width: 100%;
    padding: 0.875rem;
    background: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: 0; /* Flat */
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: not-allowed;
  }

  /* Placeholder card */
  .placeholder-card {
    justify-content: center;
    align-items: center;
    background: transparent;
    border: 2px dashed var(--color-border);
    box-shadow: none;
    opacity: 0.6;
  }

  .placeholder-content {
    text-align: center;
    color: var(--color-text-muted);
  }

  .placeholder-content span.material-symbols-outlined {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
    color: var(--color-border);
  }

  /* Buzón de Ideas */
  .idea-mailbox {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0; /* Flat */
    padding: 3.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
    box-shadow: none;
    position: relative;
    overflow: hidden;
  }

  .idea-mailbox::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  }

  .mailbox-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 700px;
  }

  .icon-bulb {
    width: 140px;
    height: 140px;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border-radius: 50%; /* Mantener redondo para efecto de brillo */
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(245, 158, 11, 0.25);
    border: none; /* Sin borde para que parezca luz */
  }

  .icon-bulb span {
    font-size: 5rem;
  }

  .mailbox-header h3 {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
    color: var(--color-text);
    font-weight: 700;
  }

  .mailbox-header p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 0; /* Flat */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    gap: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    width: auto;
  }

  .btn-small {
    padding: 1rem 2rem;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: var(--color-secondary);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .tools-grid { grid-template-columns: 1fr; }
    .idea-mailbox { padding: 2.5rem 1.5rem; }
  }
</style>
