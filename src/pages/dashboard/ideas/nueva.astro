---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ModalMessage from '../../../components/shared/ModalMessage.astro';

const token = Astro.cookies.get('session')?.value;
if (!token) {
  return Astro.redirect('/login');
}
---

<DashboardLayout title="Enviar Nueva Idea" breadcrumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Ideas', href: '/dashboard/ideas' }, { label: 'Nueva' }]} role="client">
  <div class="new-idea-page">
    <div class="page-header">
      <a href="/dashboard/herramientas" class="btn-back">
        <span class="material-symbols-outlined">arrow_back</span> Volver a Herramientas
      </a>
      <div class="header-main">
        <div class="icon-bulb">
          <span class="material-symbols-outlined">lightbulb</span>
        </div>
        <div>
          <h1>Cuéntame tu idea</h1>
          <p class="text-muted">¿Qué herramienta o funcionalidad facilitaría tu trabajo diario? Estoy aquí para construirla.</p>
        </div>
      </div>
    </div>

    <div class="form-container">
      <form id="ideaForm" class="idea-form">
        <div class="form-group">
          <label for="name">Nombre de la idea <span class="required">*</span></label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            placeholder="Ej: Generador automático de Facturas" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="explanation">Explicación breve <span class="required">*</span></label>
          <textarea 
            id="explanation" 
            name="explanation" 
            rows="6"
            placeholder="Ej: Actualmente pierdo mucho tiempo copiando datos de un Excel a la plantilla de factura. Me gustaría una herramienta donde suba el Excel y me genere los PDFs automáticamente..."
            required
          ></textarea>
          <p class="field-help">Describe el problema que resuelve y cómo te imaginas que funcionaría.</p>
        </div>

        <div class="form-group">
          <label for="image">Adjuntar imagen (opcional)</label>
          <div class="file-input-wrapper">
            <input type="file" id="image" name="image" accept="image/*" />
            <div class="file-dummy">
              <span class="material-symbols-outlined">cloud_upload</span>
              <span class="file-text">Selecciona una imagen o captura de pantalla</span>
            </div>
          </div>
          <div id="imagePreview" class="image-preview"></div>
        </div>

        <div class="form-actions">
          <button type="submit" id="submitBtn" class="btn-submit" disabled>
            Enviar idea <span class="material-symbols-outlined">send</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <ModalMessage 
    slot="modals"
    id="successIdeaModal"
    title="¡Idea Recibida!"
    message="¡Gracias! Tu idea ha sido recibida correctamente. La revisaremos pronto."
    type="success"
  />

  <ModalMessage 
    slot="modals"
    id="errorIdeaModal"
    title="Hubo un Problema"
    message="Hubo un problema al enviar tu idea. Por favor, inténtalo de nuevo más tarde."
    type="error"
  />
</DashboardLayout>

<script>
  const form = document.getElementById('ideaForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const explanationInput = document.getElementById('explanation') as HTMLTextAreaElement;
  const imageInput = document.getElementById('image') as HTMLInputElement;
  const imagePreview = document.getElementById('imagePreview') as HTMLDivElement;

  // Validación básica para habilitar botón
  const validateForm = () => {
    const isNameValid = nameInput.value.trim().length > 0;
    const isExplanationValid = explanationInput.value.trim().length > 10;
    submitBtn.disabled = !(isNameValid && isExplanationValid);
  };

  nameInput.addEventListener('input', validateForm);
  explanationInput.addEventListener('input', validateForm);

  // Preview de imagen
  imageInput.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        imagePreview.innerHTML = `<img src="${e.target?.result}" alt="Preview" />`;
        imagePreview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    } else {
      imagePreview.style.display = 'none';
      imagePreview.innerHTML = '';
    }
  });

  // Envío del formulario
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Enviando... <span class="material-symbols-outlined spinning">sync</span>';

    const formData = new FormData();
    formData.append('name', nameInput.value);
    formData.append('explanation', explanationInput.value);
    if (imageInput.files?.[0]) {
      formData.append('image', imageInput.files[0]);
    }

    try {
      // Necesitamos el token de la cookie para la API
      const sessionCookie = document.cookie.split('; ').find(row => row.startsWith('session='));
      const token = sessionCookie ? sessionCookie.split('=')[1] : null;

      const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/ideas`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      });

      if (response.ok) {
        if (window.modalHelpers) {
          window.modalHelpers.openModal('successIdeaModal');
          setTimeout(() => {
            window.location.href = '/dashboard/herramientas';
          }, 2500);
        } else {
          alert('¡Gracias! Tu idea ha sido recibida correctamente.');
          window.location.href = '/dashboard/herramientas';
        }
      } else {
        throw new Error('Error al enviar la idea');
      }
    } catch (error) {
      console.error(error);
      if (window.modalHelpers) {
        window.modalHelpers.openModal('errorIdeaModal');
      } else {
        alert('Hubo un problema al enviar tu idea. Por favor, inténtalo de nuevo.');
      }
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Enviar idea <span class="material-symbols-outlined">send</span>';
    }
  });
</script>

<style>
  .new-idea-page { max-width: 800px; margin: 0 auto; padding-bottom: 4rem; }
  
  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .btn-back:hover { color: var(--color-primary); }

  .header-main {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .icon-bulb {
    width: 80px;
    height: 80px;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border-radius: 50%; /* Única excepción redonda para brillo */
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
    flex-shrink: 0;
  }
  .icon-bulb span { font-size: 3rem; }

  .page-header h1 { font-size: var(--text-lg); margin: 0 0 0.5rem; color: var(--color-text); font-weight: 700; }
  .text-muted { font-size: var(--text-base); color: var(--color-text-muted); margin: 0; }

  .form-container {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0; /* Flat */
    padding: 3rem;
    margin-top: 2.5rem;
    box-shadow: none;
  }

  .idea-form { display: flex; flex-direction: column; gap: 2rem; }
  
  .form-group { display: flex; flex-direction: column; gap: 0.75rem; }
  .form-group label { font-weight: 700; font-size: 0.9rem; color: var(--color-text); text-transform: uppercase; letter-spacing: 0.05em; }
  .required { color: var(--color-primary); }

  input[type="text"], textarea {
    width: 100%;
    padding: 1.25rem;
    background: var(--color-surface-secondary);
    border: 2px solid var(--color-border);
    border-radius: 0; /* Flat */
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-base);
    transition: all 0.2s;
  }
  input[type="text"]:focus, textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  .field-help { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; font-style: italic; }

  /* File Input Estilizado */
  .file-input-wrapper {
    position: relative;
    width: 100%;
    min-height: 140px;
    border: 2px dashed var(--color-border);
    border-radius: 0; /* Flat */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .file-input-wrapper:hover { border-color: var(--color-primary); background: rgba(var(--color-primary-rgb), 0.02); }
  
  .file-input-wrapper input[type="file"] {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .file-dummy { text-align: center; color: var(--color-text-muted); }
  .file-dummy span.material-symbols-outlined { font-size: 3rem; margin-bottom: 0.75rem; display: block; }
  .file-text { font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  .image-preview {
    margin-top: 1.5rem;
    border-radius: 0;
    overflow: hidden;
    max-height: 400px;
    display: none;
    border: 2px solid var(--color-border);
  }
  .image-preview img { width: 100%; height: 100%; object-fit: contain; }

  .btn-submit {
    background: var(--color-primary);
    color: white;
    border: none;
    padding: 1.25rem 3rem;
    border-radius: 0; /* Flat */
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    transition: all 0.2s;
    box-shadow: none;
  }
  
  .btn-submit:hover:not(:disabled) {
    background: var(--color-secondary);
    transform: translateY(-2px);
  }
  
  .btn-submit:disabled {
    background: var(--color-surface-secondary);
    color: var(--color-text-muted);
    border: 2px solid var(--color-border);
    cursor: not-allowed;
  }

  .spinning { animation: spin 1s linear infinite; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  @media (max-width: 640px) {
    .form-container { padding: 2rem 1.5rem; }
    .header-main { flex-direction: column; text-align: center; gap: 1rem; }
  }
</style>
